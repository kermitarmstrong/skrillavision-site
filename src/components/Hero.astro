---
import Button from "./Button.astro";
import { site } from "../data/site";

const { hero } = site;
---

<section class="hero relative min-h-dvh md:min-h-screen overflow-hidden">
  <!-- Gradient fallback (visible when no video file present) -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-night via-deck to-night"
    aria-hidden="true"
  ></div>

  <!-- Hero video. If hero.mp4 doesn't exist yet, gradient above shows through. -->
  <video
    class="hero-video absolute inset-0 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={hero.poster}
    aria-hidden="true"
  >
    <source src={hero.video} type="video/mp4" />
  </video>

  <!-- Diagonal darkening overlay (improves text legibility on left side) -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-night/85 via-night/40 to-transparent"
    aria-hidden="true"
  ></div>

  <!-- Bottom gradient (smooths transition into Work section) -->
  <div
    class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-night to-transparent"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 min-h-dvh md:min-h-screen flex flex-col justify-end section-px pb-24 md:pb-32 pt-32">
    <div class="max-w-4xl">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-acid mb-6">
        {hero.eyebrow}
      </p>
      <h1
        class="font-display font-extrabold text-bone text-balance leading-[0.95]"
        style="font-size: clamp(2.5rem, 8vw, 7rem);"
      >
        {hero.headline}
      </h1>
      <p class="mt-8 text-ash text-lg md:text-xl text-pretty max-w-2xl">
        {hero.sub}
      </p>
      <div class="mt-12 flex flex-col sm:flex-row gap-5">
        <Button href={hero.primaryCta.href} variant="primary">
          {hero.primaryCta.label}
          <span aria-hidden="true">→</span>
        </Button>
        <Button href={hero.secondaryCta.href} variant="secondary">
          {hero.secondaryCta.label}
          <span aria-hidden="true">↗</span>
        </Button>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-3 pointer-events-none"
    aria-hidden="true"
  >
    <span class="font-mono text-[0.625rem] uppercase tracking-[0.3em] text-smoke">
      Scroll
    </span>
    <div class="scroll-line w-px h-10 bg-gradient-to-b from-acid to-transparent"></div>
  </div>
</section>

<style>
  .scroll-line {
    transform-origin: top;
    animation: scroll-pulse 2.4s var(--ease-in-out-expo) infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50%      { transform: scaleY(1);   opacity: 1;   }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .scroll-line { animation: none; }
    .hero-video { display: none; }
  }
</style>
