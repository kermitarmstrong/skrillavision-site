---
import { portfolio } from "../data/portfolio";

const featured = portfolio.filter((item) => item.featured).slice(0, 4);
---

<section class="section-px py-24 md:py-32 relative">
  <!-- Section header -->
  <div class="flex items-end justify-between mb-12 md:mb-16" data-reveal>
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-acid mb-4">
        01 — Work
      </p>
      <h2 class="font-display text-4xl md:text-6xl font-extrabold leading-[1.05] text-balance">
        Selected Visuals
      </h2>
    </div>
    <a
      href="/portfolio"
      class="hidden md:inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.3em] text-bone hover:text-acid transition-colors"
    >
      View all
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <!-- 2×2 grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
    {featured.map((item) => {
      const isPlaceholder = item.src.endsWith(".gitkeep");
      const imgSrc = item.type === "video" ? item.poster : item.src;

      return (
        <a
          href="/portfolio"
          class="work-card group relative block aspect-[4/3] overflow-hidden bg-deck border border-edge"
          data-reveal
        >
          {isPlaceholder ? (
            <div class="absolute inset-0 bg-gradient-to-br from-deck to-night flex items-center justify-center">
              <div class="text-center px-6">
                <p class="font-mono text-xs uppercase tracking-[0.3em] text-acid mb-2">
                  Placeholder
                </p>
                <p class="font-mono text-xs text-smoke">
                  Drop {item.type} into /media/portfolio/
                </p>
              </div>
            </div>
          ) : (
            <img
              src={imgSrc}
              alt={item.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          )}

          <!-- Overlay gradient -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-transparent transition-opacity duration-500 opacity-90 group-hover:opacity-95"
            aria-hidden="true"
          ></div>

          <!-- Card meta -->
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <p class="font-mono text-xs uppercase tracking-[0.3em] text-acid mb-2">
              {item.category} · {item.year}
            </p>
            <h3 class="font-display text-2xl md:text-3xl font-bold text-bone leading-tight">
              {item.title}
            </h3>
          </div>
        </a>
      );
    })}
  </div>

  <!-- Mobile-only "view all" link below grid -->
  <div class="mt-10 md:hidden text-center">
    <a
      href="/portfolio"
      class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.3em] text-bone hover:text-acid transition-colors"
    >
      View all work
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
